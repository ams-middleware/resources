{
  "columns": [
    {
      "id": "product",
      "labelKey": "Producto",
      "renderer": "product",
      "fields": ["name", "sku"],
      "requestOnlyFields": ["uid", "created_at", "multimedia_uid"],
      "sortable": true,
      "sortField": "name",
      "hideable": false,
      "width": 280
    },
    {
      "id": "brand",
      "labelKey": "Marca",
      "renderer": "text",
      "fields": ["attributes.brand.value.text"],
      "sortable": true,
      "sortField": "attributes.brand.value.text",
      "width": 140
    },
    {
      "id": "category_name",
      "labelKey": "Categoría",
      "renderer": "categoryName",
      "requestOnlyFields": ["category.uid", "category.name"],
      "width": 160
    },
    {
      "id": "type",
      "labelKey": "Tipo",
      "renderer": "badge",
      "fields": ["type"],
      "sortable": true,
      "width": 90,
      "center": true,
      "badge": {
        "variants": {},
        "default": { "color": "info", "uppercase": true }
      }
    },
    {
      "id": "price",
      "labelKey": "Precio",
      "renderer": "price",
      "requestOnlyFields": ["price.available", "price.special"],
      "width": 120,
      "center": true
    },
    {
      "id": "stock_real",
      "labelKey": "Stock",
      "renderer": "stockReal",
      "requestOnlyFields": ["stock.real", "stock.available", "stock.reserved"],
      "width": 110,
      "center": true
    },
    {
      "id": "connectors",
      "labelKey": "Conectores",
      "renderer": "connectors",
      "fields": ["connectors"],
      "displayColumn": false,
      "width": 90,
      "center": true
    },
    {
      "id": "updated_at",
      "labelKey": "Actualizado",
      "renderer": "datetime",
      "fields": ["updated_at"],
      "sortable": true,
      "width": 160,
      "center": true,
      "defaultHidden": true
    },
    {
      "id": "actions",
      "labelKey": "Acciones",
      "renderer": "productActions",
      "requestOnlyFields": ["uid"],
      "displayColumn": true,
      "hideable": false,
      "width": 80,
      "center": true
    }
  ]
}
