{
  "columns": [
    {
      "id": "product",
      "labelKey": "Producto",
      "renderer": "product",
      "fields": [
        "name",
        "sku"
      ],
      "requestOnlyFields": [
        "uid",
        "created_at",
        "multimedia_uid",
        "multimedia.uid"
      ],
      "sortable": true,
      "sortField": "name",
      "hideable": false
    },
    {
      "id": "brand",
      "labelKey": "Marca",
      "renderer": "text",
      "fields": [
        "attributes.brand.value.text"
      ],
      "sortable": true,
      "sortField": "attributes.brand.value.text",
      "width": 140
    },
    {
      "id": "category_name",
      "labelKey": "Categoría",
      "renderer": "categoryName",
      "requestOnlyFields": [
        "category.uid",
        "category.name"
      ],
      "width": 160
    },
    {
      "id": "type",
      "labelKey": "Tipo",
      "renderer": "badge",
      "fields": [
        "type"
      ],
      "sortable": true,
      "width": 90,
      "center": true,
      "badge": {
        "variants": {},
        "default": {
          "color": "info",
          "uppercase": true
        }
      }
    },
    {
      "id": "price",
      "labelKey": "Precio",
      "renderer": "price",
      "requestOnlyFields": [
        "price.available",
        "price.special"
      ],
      "width": 120,
      "center": true
    },
    {
      "id": "stock_real",
      "labelKey": "Stock",
      "renderer": "stockReal",
      "requestOnlyFields": [
        "stock.real",
        "stock.available",
        "stock.reserved"
      ],
      "width": 110,
      "center": true
    },
    {
      "id": "connectors",
      "labelKey": "Conectores",
      "renderer": "connectors",
      "fields": [
        "connectors"
      ],
      "displayColumn": false,
      "width": 90,
      "center": true
    },
    {
      "id": "updated_at",
      "labelKey": "Actualizado",
      "renderer": "datetime",
      "fields": [
        "updated_at"
      ],
      "sortable": true,
      "width": 160,
      "center": true,
      "defaultHidden": true
    },
    {
      "id": "actions",
      "labelKey": "Acciones",
      "renderer": "productActions",
      "requestOnlyFields": [
        "uid",
        "type",
        "price.available",
        "price.special",
        "stock.available"
      ],
      "displayColumn": true,
      "hideable": false,
      "center": true,
      "actions": [
        {
          "tooltip": "Ver producto",
          "renderer": "button-view",
          "url": "/products/{id}",
          "external_url": false,
          "permission": "PRODUCT_SHOW"
        },
        {
          "tooltip": "Editar producto",
          "renderer": "button-edit",
          "url": "/products/{id}/edit",
          "external_url": false,
          "permission": "PRODUCT_UPDATE"
        },
        {
          "tooltip": "Copiar producto",
          "renderer": "button-copy",
          "icon": "ri-file-copy-line",
          "permission": "PRODUCT_CREATE"
        },
        {
          "tooltip": "Editar precio",
          "renderer": "button-price",
          "icon": "ri-price-tag-3-line",
          "permission": "PRODUCT_UPDATE"
        },
        {
          "tooltip": "Editar stock",
          "renderer": "button-stock",
          "icon": "ri-inbox-archive-line",
          "permission": "PRODUCT_UPDATE"
        }
      ]
    }
  ]
}
