            "color": "danger"
          },
          "completed": {
            "color": "success"
          },
          "failed": {
            "color": "danger"
          },
          "deleted": {
            "color": "danger"
          },
          "success": {
            "color": "success"
          },
          "error": {
            "color": "danger"
          }
        },
        "default": {
          "color": "secondary"
        }
