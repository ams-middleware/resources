    {
      "id": "chat_status",
      "labelKey": "Chat",
      "renderer": "badge",
      "requestOnlyFields": [
        "chat.mode",
        "chat.status"
      ],
      "width": 120,
      "center": true,
      "badge": {
        "value": {
          "cases": [
            {
              "when": {
                "path": "chat.status",
                "equals": "closed"
              },
              "then": "closed"
            },
            {
              "when": {
                "path": "chat.status",
                "equals": "active"
              },
              "thenPath": "chat.mode"
            }
          ]
        },
        "variants": {
          "handoff": {
            "label": "Esperando",
            "icon": "ri-time-line",
            "variant": "warning-pulse"
          },
          "operator": {
            "label": "En atención",
            "icon": "ri-customer-service-2-line",
            "variant": "success"
          },
          "ai": {
            "label": "IA activa",
            "icon": "ri-robot-line",
            "variant": "info"
          },
          "closed": {
            "label": "Cerrado",
            "icon": "ri-chat-off-line",
            "variant": "muted"
          }
        }
      }
    },
