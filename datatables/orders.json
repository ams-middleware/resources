      "renderer": "badge",
      "fields": [
        "status",
        "order_status"
      ],
      "sortable": true,
      "center": true,
      "width": 120,
      "badge": {
        "variants": {
          "processing": {
            "color": "primary"
          },
          "pending": {
            "color": "warning"
          },
          "retrying": {
            "color": "warning"
          },
          "canceled": {
            "color": "danger"
          },
          "completed": {
            "color": "success"
          },
          "failed": {
            "color": "danger"
          },
          "deleted": {
            "color": "danger"
          },
          "paid": {
            "color": "success"
          },
          "reserved": {
            "color": "success"
          },
          "not_paid": {
            "color": "danger"
          },
          "success": {
            "color": "success"
          },
          "error": {
            "color": "danger"
          }
        },
        "default": {
          "color": "secondary"
        }
      }
    },
    {
      "id": "workflow_status",
      "labelKey": "Order col wf status",
      "renderer": "workflowStatus",
