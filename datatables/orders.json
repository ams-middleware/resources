    {
      "id": "payment",
      "labelKey": "Order col payment",
      "renderer": "badge",
      "requestOnlyFields": [
        "paid",
        "tags"
      ],
      "width": 100,
      "center": true,
      "badge": {
        "value": {
          "cases": [
            {
              "when": {
                "path": "tags",
                "contains": "paid"
              },
              "then": "paid"
            }
          ]
        },
        "variants": {
          "paid": {
            "label": "paid",
            "color": "success"
          }
        },
        "default": {
          "label": "not paid",
          "color": "danger"
        }
      }
    },
